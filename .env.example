# ---------------------------------------------------------------- mailbox ---

IMAP_HOST=mail.example.com
IMAP_PORT=993
IMAP_USERNAME=papra-intake@example.com
IMAP_PASSWORD=

IMAP_MAILBOX=INBOX

# Implicit TLS on 993. For explicit TLS on 143 set IMAP_SSL=false and
# IMAP_STARTTLS=true. Both false is refused; the password would go over the
# wire in the clear.
IMAP_SSL=true
IMAP_STARTTLS=false
IMAP_VERIFY_SSL=true

# What to do with a message once all its attachments are in Papra.
#   delete    -> flag \Deleted and expunge
#   move      -> move to IMAP_MOVE_TO, creating it if needed
#   mark_read -> set \Seen and leave it in place
IMAP_ON_SUCCESS=delete
IMAP_MOVE_TO=Processed

# Messages per run. 0 = no limit.
IMAP_BATCH_SIZE=50
IMAP_TIMEOUT_SECONDS=60


# ------------------------------------------------------------------ papra ---

# Root URL, no trailing /api.
PAPRA_BASE_URL=https://papra.example.com

# Needs documents:create, documents:read, documents:update,
# custom-properties:read and custom-properties:create.
PAPRA_API_KEY=

# Find it with:
#   curl -H "Authorization: Bearer $PAPRA_API_KEY" https://papra.example.com/api/organizations
PAPRA_ORGANIZATION_ID=org_replace_me

PAPRA_VERIFY_SSL=true
PAPRA_TIMEOUT_SECONDS=60
PAPRA_MAX_RETRIES=3

# Passed to Papra's OCR, comma separated. Empty uses the server default.
PAPRA_OCR_LANGUAGES=


# ------------------------------------------------------------ attachments ---

# Comma separated, without the dot. An empty allowed list accepts anything
# that is not denied.
# ATTACHMENTS_ALLOWED=pdf,jpg,jpeg,png,docx,xlsx
ATTACHMENTS_ALLOWED=
ATTACHMENTS_DENIED=p7s,asc,vcf,ics

# Filters out signature logos and tracking pixels.
ATTACHMENTS_MIN_SIZE_BYTES=1024

# Match Papra's DOCUMENT_STORAGE_MAX_UPLOAD_SIZE. Anything larger is reported
# as a failure and left in the mailbox rather than dropped.
ATTACHMENTS_MAX_SIZE_BYTES=26214400

# Skip parts marked inline or referenced by cid: from the HTML body.
ATTACHMENTS_SKIP_INLINE=true


# ------------------------------------------------------------------- ntfy ---

NTFY_ENABLED=false
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=imap-to-papra
NTFY_TOKEN=
NTFY_PRIORITY=default

# Use "error" alone for errors only.
NTFY_NOTIFY_ON=success,error
NTFY_TIMEOUT_SECONDS=10


# ---------------------------------------------------------------- runtime ---

# DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# text or json
LOG_FORMAT=text

# Lock file used to stop two runs overlapping. Empty uses the system temp dir.
LOCK_FILE=
